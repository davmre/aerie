<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted credentials from cloud backup -->
        <exclude domain="sharedpref" path="aerie_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude encrypted credentials from device transfer -->
        <exclude domain="sharedpref" path="aerie_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
