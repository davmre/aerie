{
  "manifest_version": 2,
  "name": "Aerie Tweet Collector",
  "version": "0.3.0",
  "description": "Captures tweets from Twitter's API and filters your feed",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aerie@local.dev",
      "strict_min_version": "57.0"
    }
  }
}
